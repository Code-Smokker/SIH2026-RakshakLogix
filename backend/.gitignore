# ============================================================
# RakshakLogix — .gitignore
# ============================================================

# Environment — NEVER commit real secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-wheel-metadata/
*.pyo

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Alembic (keep versions, ignore local state)
alembic/versions/__pycache__/

# Data — do not commit raw or processed data to SCM
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Docker
.docker/

# Distribution / packaging
*.tar.gz
