# ============================================================
# RakshakLogix Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to source control.
# ============================================================

# ---------------------
# Application
# ---------------------
APP_ENV=development
APP_NAME=RakshakLogix
APP_VERSION=0.1.0
APP_DEBUG=false
LOG_LEVEL=INFO

# ---------------------
# API
# ---------------------
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:8080"]

# ---------------------
# Database — PostgreSQL/PostGIS
# ---------------------
DATABASE_URL=postgresql+asyncpg://rakshak:rakshak_dev@localhost:5432/rakshaklogix
DATABASE_SYNC_URL=postgresql+psycopg2://rakshak:rakshak_dev@localhost:5432/rakshaklogix
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ---------------------
# Redis
# ---------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------
# Authentication (JWT)
# ---------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION_USE_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------
# Password hashing
# ---------------------
# Options: argon2id | bcrypt
PASSWORD_HASH_SCHEME=argon2id

# ---------------------
# Rate limiting
# ---------------------
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ---------------------
# Synthetic data seed
# ---------------------
SYNTHETIC_DATA_SEED=42
